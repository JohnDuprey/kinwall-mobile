<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Countdowns.kt: re-arm the leave-by alarms after a restart, and ask Android 16 to show the
       countdowns as Live Updates (the status bar chip and the top of the Lock Screen). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <application>
    <!-- The reminders' Snooze, Taken and Done (ReminderActions.kt): expo-notifications hands its
         events to the highest-priority receiver for them; its own has -1. -->
    <receiver android:name="family.kinwall.nativemodule.ReminderActions" android:exported="false">
      <intent-filter android:priority="0">
        <action android:name="expo.modules.notifications.NOTIFICATION_EVENT" />
      </intent-filter>
    </receiver>
    <receiver android:name="family.kinwall.nativemodule.CountdownReceiver" android:exported="false" />
    <receiver android:name="family.kinwall.nativemodule.CountdownBootReceiver" android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- "Kinwall" in the share sheet (ShareActivity.kt): links, text and photos. Contacts (vCards)
         stay on the main activity (plugins/withKinwallNative.js). -->
    <activity android:name="family.kinwall.nativemodule.ShareActivity" android:exported="true" android:label="@string/kinwall_share_label"
      android:theme="@style/KinwallShare" android:excludeFromRecents="true" android:taskAffinity=""
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="text/plain" />
        <data android:mimeType="image/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="image/*" />
      </intent-filter>
    </activity>
    <!-- Quick Settings tiles (Tiles.kt). -->
    <service android:name="family.kinwall.nativemodule.GroceriesTile" android:exported="true" android:label="@string/kinwall_tile_groceries"
      android:icon="@drawable/kinwall_ic_add" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
    <service android:name="family.kinwall.nativemodule.NightScreenTile" android:exported="true" android:label="@string/kinwall_tile_night"
      android:icon="@drawable/kinwall_ic_night" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE" /></intent-filter>
    </service>
  </application>
</manifest>
